# Get a free key at https://console.groq.com/keys
EXPO_PUBLIC_GROQ_API_KEY=your_groq_api_key_here

# Optional: override the default model
# EXPO_PUBLIC_GROQ_MODEL=openai/gpt-oss-120b

# Get a free key at https://aistudio.google.com/apikey — used for the
# experimental audio-based Scan feature (Gemini listens to the recording).
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the default model
# EXPO_PUBLIC_GEMINI_MODEL=gemini-flash-latest
